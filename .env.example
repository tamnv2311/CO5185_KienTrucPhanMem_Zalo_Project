# Settings of the cloud deployment (docker-compose.prod.yml).
# Copy to ".env" on the server and fill in. Never commit the real file.

# Where the site is served.
#   :80                -> http://<server-ip>        (no HTTPS)
#   chat.example.com   -> https://chat.example.com  (certificate is issued automatically;
#                         the domain's DNS A record must point to this server first)
SITE_ADDRESS=:80

# Signs the login tokens. At least 32 random characters, e.g. from:  openssl rand -base64 48
JWT_SECRET=

# Database and message broker passwords (internal only, but still use long random values).
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
RABBITMQ_PASSWORD=

# Optional: memory per Java service. 256m fits a 4 GB server; raise it on bigger machines.
# JAVA_MAX_HEAP=256m
